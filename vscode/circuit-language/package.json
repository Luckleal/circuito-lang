{
  "name": "circuit-language",
  "displayName": "Circuit Language",
  "description": "Syntax highlighting for the circuito-lang logic-circuit language (.circ).",
  "version": "0.1.0",
  "publisher": "local",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "circuit",
        "aliases": ["Circuit", "circuit"],
        "extensions": [".circ"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      { "language": "circuit", "scopeName": "source.circuit", "path": "./syntaxes/circuit.tmLanguage.json" }
    ]
  }
}
