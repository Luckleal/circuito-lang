{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Circuit",
  "scopeName": "source.circuit",
  "patterns": [
    { "name": "comment.line.double-slash.circuit", "match": "//.*$" },
    { "name": "string.quoted.double.circuit", "match": "\"[^\"\\r\\n]*\"" },
    { "name": "storage.modifier.annotation.circuit", "match": "@(?=delay\\b)" },
    { "name": "keyword.control.circuit", "match": "\\b(circuit|input|output|wire|delay)\\b" },
    { "name": "keyword.operator.logical.circuit", "match": "\\b(XNOR|NOR|NAND|XOR|NOT|OR|AND)\\b" },
    { "name": "constant.numeric.float.circuit", "match": "\\b[0-9]+\\.[0-9]+\\b" },
    { "name": "constant.numeric.integer.circuit", "match": "\\b[0-9]+\\b" },
    { "name": "variable.other.circuit", "match": "\\b[a-zA-Z_][a-zA-Z_0-9]*\\b" }
  ]
}
